{% style %}
  .comparison-{{ section.id }} { padding: 40px 20px; font-family: sans-serif; background: #fafafa; }
  .logos-grid { display: flex; justify-content: center; gap: 20px; font-weight: bold; font-family: serif; font-size: 18px; color: #888; margin-bottom: 40px; flex-wrap: wrap;}
  .section-title { text-align: center; font-size: 24px; font-weight: bold; margin-bottom: 10px; }
  .section-sub { text-align: center; color: #666; margin-bottom: 30px; font-size: 15px;}
  
  .video-wrapper { max-width: 800px; margin: 0 auto 40px auto; border-radius: 12px; overflow: hidden; position: relative; background: #000; aspect-ratio: 16/9; }
  .video-wrapper video { width: 100%; height: 100%; object-fit: cover; }
  
  .compare-table { width: 100%; max-width: 800px; margin: 0 auto; border-collapse: collapse; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
  .compare-table th, .compare-table td { padding: 15px; text-align: center; border-bottom: 1px solid #eee; font-size: 14px;}
  .compare-table th { background: #111; color: white; }
  .compare-table th.brand-col { background: #ff4d6d; }
  .compare-table td:first-child { text-align: left; font-weight: bold; color: #333; }
  .check { color: #16a34a; font-weight: bold; font-size: 18px; }
  .cross { color: #dc2626; font-weight: bold; font-size: 18px; opacity: 0.5; }
{% endstyle %}

<div class="comparison-{{ section.id }}">
  <div style="text-align:center; font-size:12px; font-weight:bold; margin-bottom:15px; color:#888;">COMO SE HA VISTO EN</div>
  <div class="logos-grid">
    <span>VOGUE</span> <span>COSMOPOLITAN</span> <span>ELLE</span> <span>GLAMOUR</span>
  </div>

  <h2 class="section-title">{{ section.settings.video_title }}</h2>
  <p class="section-sub">{{ section.settings.video_sub }}</p>
  
  <div class="video-wrapper">
    {% if section.settings.video %}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true }}
    {% else %}
      <div style="color:white; display:flex; align-items:center; justify-content:center; height:100%;">Selecciona un Video</div>
    {% endif %}
  </div>

  <h2 class="section-title" style="margin-top: 50px;">Por qué somos diferentes</h2>
  <p class="section-sub">La diferencia es clara. Deja atrás los métodos dolorosos.</p>

  <table class="compare-table">
    <tr>
      <th>BENEFICIO</th>
      <th class="brand-col">{{ section.settings.brand_name }}</th>
      <th>Otros Métodos</th>
    </tr>
    {% for block in section.blocks %}
      <tr {{ block.shopify_attributes }}>
        <td>{{ block.settings.benefit }}</td>
        <td><span class="check">✓</span></td>
        <td><span class="cross">✕</span></td>
      </tr>
    {% endfor %}
  </table>
</div>

{% schema %}
{
  "name": "Video y Tabla Comparativa",
  "settings": [
    { "type": "text", "id": "video_title", "label": "Título Video", "default": "Míralo en Acción" },
    { "type": "text", "id": "video_sub", "label": "Subtítulo Video", "default": "No solo nos creas a nosotros..." },
    { "type": "video", "id": "video", "label": "Video Tutorial" },
    { "type": "text", "id": "brand_name", "label": "Nombre de tu Marca", "default": "Crystal Eraser" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio a Comparar",
      "settings": [
        { "type": "text", "id": "benefit", "label": "Texto del Beneficio", "default": "100% Libre de dolor" }
      ]
    }
  ],
  "presets": [{ "name": "Video y Tabla Comparativa", "blocks": [ { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" } ] }]
}
{% endschema %}
