{% style %}
  .hero-{{ section.id }} { padding: 20px; font-family: sans-serif; max-width: 800px; margin: 0 auto; }
  .hero-img { width: 100%; border-radius: 12px; margin-bottom: 15px; }
  .trust-badge-top { display: inline-flex; align-items: center; gap: 5px; background: #f0fdf4; color: #166534; padding: 5px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; margin-bottom: 10px; border: 1px solid #bbf7d0;}
  .hero-title { font-size: 28px; font-weight: 800; line-height: 1.2; margin-bottom: 10px; }
  .hero-title span { color: #ff4d6d; }
  .hero-desc { color: #555; font-size: 15px; margin-bottom: 25px; line-height: 1.5; }
  
  .bundle-container { display: flex; flex-direction: column; gap: 15px; margin-bottom: 20px;}
  .bundle-option { border: 2px solid #eaeaea; border-radius: 10px; padding: 15px; position: relative; cursor: pointer; display: flex; align-items: center; justify-content: space-between; transition: all 0.2s;}
  .bundle-option.active { border-color: #ff4d6d; background: #fff5f7; }
  .bundle-tag { position: absolute; top: -10px; left: 15px; background: #ff4d6d; color: white; font-size: 10px; font-weight: bold; padding: 3px 8px; border-radius: 4px; }
  .bundle-info h4 { margin: 0; font-size: 16px; font-weight: bold; }
  .bundle-info p { margin: 0; font-size: 12px; color: #777; }
  .bundle-price { text-align: right; }
  .bundle-price .current { font-weight: bold; font-size: 16px; color: #ff4d6d; display: block;}
  .bundle-price .old { text-decoration: line-through; color: #999; font-size: 12px; }
  
  .btn-buy { width: 100%; background: #ff4d6d; color: white; text-align: center; padding: 18px; border-radius: 8px; font-size: 18px; font-weight: bold; text-transform: uppercase; border: none; cursor: pointer; margin-bottom: 20px; display: flex; justify-content: center; align-items: center; gap: 10px;}
  .trust-icons { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; font-size: 12px; color: #555; }
  .trust-icons div { display: flex; align-items: center; gap: 8px; }
{% endstyle %}

<div class="hero-{{ section.id }}">
  {% if section.settings.image %}
    <img src="{{ section.settings.image | img_url: 'master' }}" class="hero-img">
  {% else %}
    <div style="width:100%; height:300px; background:#f4f4f4; border-radius:12px; margin-bottom:15px;"></div>
  {% endif %}

  <div class="trust-badge-top">🛡️ {{ section.settings.guarantee_text }}</div>
  <div style="color:#f59e0b; font-size:14px; font-weight:bold; margin-bottom:10px;">
    ⭐⭐⭐⭐⭐ {{ section.settings.reviews_text }}
  </div>

  <h1 class="hero-title">{{ section.settings.title }}</h1>
  <p class="hero-desc">{{ section.settings.description }}</p>

  <div class="bundle-container">
    {% for block in section.blocks %}
      <div class="bundle-option {% if forloop.index == 2 %}active{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.tag != blank %}
          <div class="bundle-tag" style="background:{{ block.settings.tag_color }}">{{ block.settings.tag }}</div>
        {% endif %}
        <div style="display:flex; align-items:center; gap:15px;">
          <input type="radio" name="bundle" {% if forloop.index == 2 %}checked{% endif %}>
          <div class="bundle-info">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.subtitle }}</p>
          </div>
        </div>
        <div class="bundle-price">
          <span class="current">{{ block.settings.price }}</span>
          <span class="old">{{ block.settings.compare_price }}</span>
        </div>
      </div>
    {% endfor %}
  </div>

  <button class="btn-buy">COMPRAR AHORA ➔</button>

  <div class="trust-icons">
    <div>📦 Indoloro y libre de químicos</div>
    <div>✨ Adiós a la piel de fresa</div>
    <div>🚫 Previene vellos encarnados</div>
    <div>♻️ Reutilizable hasta 3 años</div>
  </div>
</div>

{% schema %}
{
  "name": "Hero y Ofertas",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen Principal" },
    { "type": "text", "id": "guarantee_text", "label": "Texto de Garantía", "default": "30 Días de Prueba" },
    { "type": "text", "id": "reviews_text", "label": "Texto Reseñas", "default": "Más de 250,000 clientes felices" },
    { "type": "html", "id": "title", "label": "Título Principal", "default": "La forma más <span>fácil y sin dolor</span> de eliminar el vello." },
    { "type": "textarea", "id": "description", "label": "Descripción", "default": "Despídete de las cortadas y la irritación..." }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Opción de Oferta",
      "settings": [
        { "type": "text", "id": "tag", "label": "Etiqueta (Ej: MÁS POPULAR)" },
        { "type": "color", "id": "tag_color", "label": "Color Etiqueta", "default": "#ff4d6d" },
        { "type": "text", "id": "title", "label": "Título", "default": "1x Borrador" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Para probar" },
        { "type": "text", "id": "price", "label": "Precio Actual", "default": "$29.99" },
        { "type": "text", "id": "compare_price", "label": "Precio Original", "default": "$59.99" }
      ]
    }
  ],
  "presets": [{ "name": "Hero y Ofertas", "blocks": [ { "type": "bundle" }, { "type": "bundle" }, { "type": "bundle" } ] }]
}
{% endschema %}
