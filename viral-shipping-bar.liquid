{% style %}
  .shipping-bar-{{ section.id }} {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 15px;
    border-radius: 10px;
    font-family: sans-serif;
    text-align: center;
    margin: 15px 0;
    border: 1px solid #eaeaea;
  }
  .shipping-text {
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 8px;
  }
  .progress-bar-bg {
    width: 100%;
    height: 10px;
    background: #e5e7eb;
    border-radius: 5px;
    overflow: hidden;
  }
  .progress-bar-fill {
    width: {{ section.settings.percentage }}%;
    height: 100%;
    background: {{ section.settings.fill_color }};
    border-radius: 5px;
    transition: width 0.3s ease;
  }
{% endstyle %}

<div class="shipping-bar-{{ section.id }}">
  <div class="shipping-text">
    {{ section.settings.message_before }} <span style="color: {{ section.settings.fill_color }};">{{ section.settings.amount_left }}</span> {{ section.settings.message_after }}
  </div>
  <div class="progress-bar-bg">
    <div class="progress-bar-fill"></div>
  </div>
</div>

{% schema %}
{
  "name": "Barra de Progreso Envío",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Color de fondo", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Color de texto", "default": "#333333" },
    { "type": "color", "id": "fill_color", "label": "Color de barra", "default": "#ff4d6d" },
    { "type": "text", "id": "message_before", "label": "Texto inicial", "default": "¡Te faltan" },
    { "type": "text", "id": "amount_left", "label": "Monto faltante", "default": "$10.00" },
    { "type": "text", "id": "message_after", "label": "Texto final", "default": "para obtener ENVÍO GRATIS!" },
    { "type": "range", "id": "percentage", "min": 10, "max": 100, "step": 5, "label": "Porcentaje de barra", "default": 75 }
  ],
  "presets": [{ "name": "Barra de Progreso Envío" }]
}
{% endschema %}
